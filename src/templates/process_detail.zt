const layout = @import("layout.zig");
const compensation = @import("compensation.zig");
const components = @import("components.zig");
const company_questions = @import("company_questions.zig");
const stage_timeline = @import("stage_timeline.zig");
const view_models = @import("../view_models.zig");

pub templ ProcessDetailContent(view: view_models.ProcessDetail) {
    <div class="actions">
        <a class="secondary" href="/">← Dashboard</a>
        <a class="button" href={view.edit_url}>Edit process</a>
    </div>
    <section class="panel process-hero">
        <h1>{view.company_name}</h1>
        <h2>{view.position_name}</h2>
        <p class="process-meta"><span class="badge">{view.status}</span> · Applied {view.applied_at}</p>
        if (view.source.len > 0) { <p class="process-source">{view.source}</p> }
        @RatingsSection(view.ratings)
        @CompanySummarySection(view.company_summary)
        <div class="process-secondary">
            if (view.job_url) |job_url| { <a rel="noopener noreferrer" href={job_url} hx-boost="false">Job posting</a> }
            if (view.location.len > 0) { <span>{view.location}</span> }
            if (view.work_arrangement.len > 0) { <span>{view.work_arrangement}</span> }
        </div>
    </section>
    @compensation.CompensationSection(view.compensation)
    @stage_timeline.StageTimeline(view.timeline)
    @company_questions.CompanyQuestions(view.company_questions)
    <section class="panel danger-zone">
        <h2>Danger zone</h2>
        <p>This permanently deletes the job process and all stages, notes, questions, appointments and compensation records.</p>
        <form
            method="post"
            action={view.delete_url}
            hx-post={view.delete_url}
            hx-confirm="Delete this job process and all associated data?"
        >
            <button class="danger" type="submit">Delete job process</button>
        </form>
    </section>
}

pub templ RatingsSection(view: view_models.RatingsSection) {
    if (view.editing) {
        @RatingsEditor(view)
    } else {
        @RatingsDisplay(view)
    }
}

pub templ RatingsDisplay(view: view_models.RatingsSection) {
    <section id="process-ratings" class="process-ratings editable-region">
        <button
            type="button"
            class="editable-property ratings-display"
            aria-label="Edit ratings"
            hx-get={view.edit_url}
            hx-target="#process-ratings"
            hx-swap="outerHTML"
        >
            <span class="editable-property-heading">
                <strong>My rating</strong>
                <span class="edit-icon">
                    @components.PencilIcon()
                </span>
            </span>
            <span class="rating-row"><span>Interest</span><strong>{view.interest}</strong></span>
            <span class="rating-row"><span>Money</span><strong>{view.money}</strong></span>
            <span class="rating-row"><span>Growth</span><strong>{view.growth}</strong></span>
        </button>
    </section>
}

pub templ RatingsEditor(view: view_models.RatingsSection) {
    <section id="process-ratings" class="process-ratings inline-editor">
        <h2>My rating</h2>
        <form method="post" action={view.action} hx-post={view.action} hx-target="#process-ratings" hx-swap="outerHTML">
            <div class="form-grid ratings-grid">
                <label>
                    Interest
                    <select name="interest_rating" aria-label="Interest rating">
                        <option value="" selected={if (view.interest_value.len == 0) "selected" else null}>Not rated</option>
                        <option value="1" selected={if (std.mem.eql(u8, view.interest_value, "1")) "selected" else null}>1</option>
                        <option value="2" selected={if (std.mem.eql(u8, view.interest_value, "2")) "selected" else null}>2</option>
                        <option value="3" selected={if (std.mem.eql(u8, view.interest_value, "3")) "selected" else null}>3</option>
                        <option value="4" selected={if (std.mem.eql(u8, view.interest_value, "4")) "selected" else null}>4</option>
                        <option value="5" selected={if (std.mem.eql(u8, view.interest_value, "5")) "selected" else null}>5</option>
                    </select>
                </label>
                <label>
                    Money
                    <select name="money_rating" aria-label="Money rating">
                        <option value="" selected={if (view.money_value.len == 0) "selected" else null}>Not rated</option>
                        <option value="1" selected={if (std.mem.eql(u8, view.money_value, "1")) "selected" else null}>1</option>
                        <option value="2" selected={if (std.mem.eql(u8, view.money_value, "2")) "selected" else null}>2</option>
                        <option value="3" selected={if (std.mem.eql(u8, view.money_value, "3")) "selected" else null}>3</option>
                        <option value="4" selected={if (std.mem.eql(u8, view.money_value, "4")) "selected" else null}>4</option>
                        <option value="5" selected={if (std.mem.eql(u8, view.money_value, "5")) "selected" else null}>5</option>
                    </select>
                </label>
                <label>
                    Growth
                    <select name="growth_rating" aria-label="Growth rating">
                        <option value="" selected={if (view.growth_value.len == 0) "selected" else null}>Not rated</option>
                        <option value="1" selected={if (std.mem.eql(u8, view.growth_value, "1")) "selected" else null}>1</option>
                        <option value="2" selected={if (std.mem.eql(u8, view.growth_value, "2")) "selected" else null}>2</option>
                        <option value="3" selected={if (std.mem.eql(u8, view.growth_value, "3")) "selected" else null}>3</option>
                        <option value="4" selected={if (std.mem.eql(u8, view.growth_value, "4")) "selected" else null}>4</option>
                        <option value="5" selected={if (std.mem.eql(u8, view.growth_value, "5")) "selected" else null}>5</option>
                    </select>
                </label>
            </div>
            <div class="inline-actions"><button type="submit">Save</button><button type="button" class="secondary" hx-get={view.action} hx-target="#process-ratings" hx-swap="outerHTML">Cancel</button></div>
        </form>
    </section>
}

pub templ CompanySummarySection(view: view_models.CompanySummarySection) {
    if (view.editing) {
        <section id="company-summary" class="inline-editor">
            <h3>About</h3>
            <form method="post" action={view.action} hx-post={view.action} hx-target="#company-summary" hx-swap="outerHTML">
                <label>About the company<textarea name="company_summary" rows="4">{view.summary}</textarea></label>
                if (view.error_message) |message| { <p class="error">{message}</p> }
                <div class="inline-actions"><button type="submit">Save</button><button type="button" class="secondary" hx-get={view.action} hx-target="#company-summary" hx-swap="outerHTML">Cancel</button></div>
            </form>
        </section>
    } else {
        <section id="company-summary" class="editable-region">
            <button
                type="button"
                class="editable-property company-summary-display"
                aria-label="Edit About the company"
                hx-get={view.edit_url}
                hx-target="#company-summary"
                hx-swap="outerHTML"
            >
                <span class="editable-property-heading">
                    <strong>About</strong>
                    <span class="edit-icon">
                        @components.PencilIcon()
                    </span>
                </span>
                if (view.summary.len > 0) { <span class="preserve-lines">{view.summary}</span> } else { <span class="muted">Not recorded.</span> }
            </button>
        </section>
    }
}

pub templ ProcessDetailPage(view: view_models.ProcessDetail) {
    @layout.Layout(view.title) { @ProcessDetailContent(view) }
}

pub templ ProcessDetailFragment(view: view_models.ProcessDetail) {
    <title>{view.title} · Interview CRM</title>
    @ProcessDetailContent(view)
}
