const layout = @import("layout.zig");
const view_models = @import("../view_models.zig");

pub templ ErrorContent(view: view_models.ErrorPage) {
    <section class="panel error-page">
        <h1>{view.title}</h1>
        <p>{view.message}</p>
        <a href="/">Return to dashboard</a>
    </section>
}

pub templ ErrorPage(view: view_models.ErrorPage) {
    @layout.Layout(view.title) {
        @ErrorContent(view)
    }
}

pub templ ErrorFragment(view: view_models.ErrorPage) {
    <title>{view.title} · Interview CRM</title>
    @ErrorContent(view)
}
