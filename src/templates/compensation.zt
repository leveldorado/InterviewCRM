const view_models = @import("../view_models.zig");
const components = @import("components.zig");

pub templ CompensationEditor(view: view_models.CompensationSnapshot) {
    if (view.editing) {
        @CompensationEdit(view)
    } else {
        @CompensationDisplay(view)
    }
}

pub templ CompensationDisplay(view: view_models.CompensationSnapshot) {
    <section id={view.region_id} class="stage-section compensation-editor editable-region">
        <button
            type="button"
            class="editable-property compensation-display"
            aria-label="Edit compensation"
            hx-get={view.edit_action}
            hx-target={view.target_id}
            hx-swap="outerHTML"
        >
            <span class="editable-property-heading">
                <strong class="compensation-label">{view.label}</strong>
                <span class="edit-icon">
                    @components.PencilIcon()
                </span>
            </span>
            <strong class="compensation-value">{view.display}</strong>
            if (view.notes) |notes| {
                <span class="muted preserve-lines">{notes}</span>
            }
        </button>
    </section>
}

pub templ CompensationEdit(view: view_models.CompensationSnapshot) {
    <section id={view.region_id} class="stage-section compensation-editor inline-editor">
        <h4>{view.label}</h4>
        <form method="post" action={view.action} hx-post={view.action} hx-target={view.target_id} hx-swap="outerHTML">
                <div class="salary-editor">
                    <label class="check salary-range-toggle">
                        <input name="is_range" type="checkbox" value="1" checked={if (view.form.input.amount_max != null) "checked" else null} />
                        Salary is a range
                    </label>
                    <div class="salary-single">
                        <label>
                            Amount
                            <input name="amount" inputmode="numeric" value={view.form.minimum_value} />
                            if (view.form.errors.amount_min) |message| { <span class="error">{message}</span> }
                        </label>
                    </div>
                    <div class="salary-range form-grid">
                        <label>
                            From
                            <input name="amount_from" inputmode="numeric" value={view.form.minimum_value} />
                            if (view.form.errors.amount_min) |message| { <span class="error">{message}</span> }
                        </label>
                        <label>
                            To
                            <input name="amount_to" inputmode="numeric" value={view.form.maximum_value} />
                            if (view.form.errors.amount_max) |message| { <span class="error">{message}</span> }
                        </label>
                    </div>
                </div>
                <div class="form-grid">
                    <label>Currency<input name="currency" maxlength="12" value={view.form.input.currency} /></label>
                    <label>
                        Period
                        <select name="period">
                            <option value="" selected={if (view.form.input.period.len == 0) "selected" else null}>Not specified</option>
                            <option value="hour" selected={if (std.mem.eql(u8, view.form.input.period, "hour")) "selected" else null}>Hour</option>
                            <option value="month" selected={if (std.mem.eql(u8, view.form.input.period, "month")) "selected" else null}>Month</option>
                            <option value="year" selected={if (std.mem.eql(u8, view.form.input.period, "year")) "selected" else null}>Year</option>
                        </select>
                    </label>
                    <label>
                        Type
                        <select name="salary_type">
                            <option value="" selected={if (view.form.input.salary_type.len == 0) "selected" else null}>Not specified</option>
                            <option value="gross" selected={if (std.mem.eql(u8, view.form.input.salary_type, "gross")) "selected" else null}>Gross</option>
                            <option value="net" selected={if (std.mem.eql(u8, view.form.input.salary_type, "net")) "selected" else null}>Net</option>
                        </select>
                    </label>
                </div>
                if (view.show_confirmed) {
                    <label class="check"><input name="confirmed" type="checkbox" value="1" checked={if (view.form.input.confirmed) "checked" else null} /> Confirmed</label>
                }
                <label>Notes<textarea name="notes" rows="3">{view.form.input.notes}</textarea></label>
                <div class="inline-actions"><button type="submit">Save</button><button type="button" class="secondary" hx-get={view.action} hx-target={view.target_id} hx-swap="outerHTML">Cancel</button></div>
        </form>
    </section>
}

pub templ CompensationSection(view: view_models.CompensationSection) {
    <section id="compensation-section" class="compensation-summary">
        <h2>Compensation</h2>
        <dl>
            for (view.snapshots) |snapshot| {
                <dt>{if (std.mem.eql(u8, snapshot.kind, "advertised")) "Posted" else snapshot.label}</dt>
                <dd>{snapshot.display}</dd>
            }
        </dl>
    </section>
}
